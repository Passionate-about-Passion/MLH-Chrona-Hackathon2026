# Copy to .env.local and fill in. NEVER commit .env.local.
#   cp .env.example .env.local

# Which backend the app uses by default: gemini | digitalocean | ollama
AI_PROVIDER=gemini

# --- Google Gemini API (hosted Gemma 4) ---------------------------------
# Key: https://aistudio.google.com/apikey
# Models: gemma-4-26b-a4b-it (recommended start) | gemma-4-31b-it
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it

# --- DigitalOcean Inference (OpenAI-compatible) -------------------------
# Sign-up credits: https://mlh.link/digitalocean-signup
# Create a model access key in the DO control panel (Inference).
# Look up the exact Gemma 4 model ID in the DO Model Catalog and paste it here.
DO_API_KEY=
DO_BASE_URL=https://inference.do-ai.run/v1
DO_MODEL=

# --- Local Gemma via Ollama (optional, "data never leaves the device") ---
# Check the exact tag on ollama.com/library before pulling.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:e4b
# Set to 1 to include Ollama in `npm run test:gemma`
OLLAMA_TEST=0

# --- ElevenLabs (Slice D, optional — falls back to browser speech) -------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Mock mode: fake API answers so the UI can be built without AI ------
# Default ON until we get keys tomorrow morning. Set to 0 once keys are in. TURN OFF BEFORE THE DEMO.
MOCK=1
